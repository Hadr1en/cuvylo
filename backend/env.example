# Cuvylo — configuration du BACKEND PHP.
# En production, inutile de partir de ce modèle : l'assistant d'installation (première visite du site) écrit
# lui-même `.env`. Ce fichier documente chaque réglage, pour le modifier ensuite ou tout configurer à la main.
# À copier en `.env` (jamais committé) dans le dossier désigné par CUVYLO_HOME :
#   - local : backend/.env
#   - hébergement : ~/cuvylo/.env (hors du dossier du site)
# Ce fichier n'est lu que par PHP ; rien ici n'est exposé au frontend.
# Les vraies variables d'environnement, si elles existent, l'emportent sur ce fichier.
# (Le dépôt doit aussi porter une copie de ce modèle sous le nom `.env.example` à la racine.)

# production | development | testing — en production, APP_URL doit être en https.
APP_ENV=production

# Origine publique de l'application (sans chemin). Sert au contrôle de l'en-tête Origin et aux cookies Secure.
# Développement local avec Vite : http://localhost:5173
APP_URL=https://cv.example.fr

# Clé applicative (≥ 32 octets aléatoires, encodés en base64). Sert à signer les jetons CSRF
# et à hacher IP/e-mail dans les journaux de sécurité.
# Générer : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Connexion PDO. MySQL (hébergement) : mysql:host=<serveur-sql>;dbname=<base>;charset=utf8mb4
# Développement local sans MySQL : sqlite:/chemin/absolu/vers/cuvylo.sqlite
DB_DSN=mysql:host=localhost;dbname=cuvylo;charset=utf8mb4
DB_USER=
DB_PASSWORD=

# Sessions : inactivité maximale (minutes, expiration glissante) et durée absolue (jours).
SESSION_LIFETIME_MINUTES=10080
SESSION_ABSOLUTE_LIFETIME_DAYS=30

# Configuration écrite à la main uniquement (l'assistant crée lui-même l'administrateur) : code demandé par
# l'écran /installation pour créer le PREMIER compte. 16 caractères au moins, à choisir vous-même. Sans lui, et
# avec ce fichier déjà présent, personne ne peut créer ce compte ; une fois créé, l'écran se ferme définitivement.
SETUP_CODE=

# Inscription libre (défaut : false). Les invitations à usage unique créées depuis l'administration
# fonctionnent même à false : c'est le mode recommandé. Le premier compte (administrateur) se crée
# par l'écran /installation avec SETUP_CODE, sans ouvrir l'inscription.
REGISTRATION_ENABLED=false
# Si renseigné (et inscription libre), le code est exigé à l'inscription (tentatives erronées limitées).
REGISTRATION_INVITE_CODE=
# Inscriptions acceptées par heure et par adresse IP (anti-abus). Défaut : 10.
REGISTRATION_MAX_PER_IP_HOUR=10

# Administrateurs supplémentaires (le compte créé par /installation l'est déjà) : e-mails séparés par des
# virgules. L'administration donne les invitations, l'espace utilisé, la suppression de comptes et les liens
# de réinitialisation demandés par les utilisateurs ; jamais le contenu des CV ni la base.
# Sauvegarde : export SQL depuis l'espace client de l'hébergeur, ou `php bin/backup.php` en SSH.
ADMIN_EMAILS=

# ── Envoi d'e-mails (réinitialisation du mot de passe) ──
# Vide : aucun envoi ; « Mot de passe oublié » passe alors par l'administrateur.
#   smtp : n'importe quel serveur SMTP authentifié (boîte e-mail de votre domaine, Gmail avec mot de passe
#          d'application, Brevo, Mailgun, Postmark…). Recommandé.
#   mail : fonction mail() de PHP, si votre hébergement la fournit.
#   file : écrit les messages dans MAIL_FILE_DIR (développement et tests ; refusé en production).
MAIL_TRANSPORT=
# Expéditeur (une adresse de votre domaine, autorisée par son SPF, pour ne pas finir en indésirables).
MAIL_FROM=
MAIL_FROM_NAME=Cuvylo
# SMTP : TLS obligatoire. ssl = TLS dès la connexion (port 465, défaut) ; starttls = port 587.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FILE_DIR=

# Quota par compte en Mo (profil + CV + versions + lettres + candidatures + partages).
USER_STORAGE_LIMIT_MB=25

# Fichier de journal (hors racine web). Vide : journal d'erreurs PHP (error_log).
# Le motif {month} est remplacé par le mois courant (ex. /home/user/logs/cuvylo-{month}.log → …-2026-10.log) :
# un fichier par mois, à supprimer à la main au-delà de 12 mois.
LOG_PATH=

# ── Informations légales de VOTRE instance (pages « Mentions légales », « Confidentialité », « Sécurité ») ──
# Quiconque installe Cuvylo est l'éditeur et le responsable de traitement de sa propre instance.
# Éditeur : votre nom, ou vide pour un particulier qui garde l'anonymat (LCEN art. 6-III-2).
LEGAL_PUBLISHER=
# Contact affiché (exercice des droits RGPD). Obligatoire dès que d'autres personnes ont un compte.
LEGAL_CONTACT_EMAIL=
# Hébergeur, sur une ligne : raison sociale, adresse, téléphone (coordonnées officielles de l'hébergeur).
LEGAL_HOST=
# Contact sécurité publié dans /.well-known/security.txt ; vide : LEGAL_CONTACT_EMAIL.
SECURITY_CONTACT_EMAIL=
