# API Cuvylo — à déployer dans www/api/ (Apache 2.4, mod_rewrite requis [À VÉRIFIER selon l'hébergeur]).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Tout ce qui n'est pas un fichier existant passe par le front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Jamais de fichiers cachés (.env, .git…) ni de sources servis.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|json|lock|log|bak|ini)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store"
</IfModule>
