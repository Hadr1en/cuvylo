{
  "name": "hadr1en/cuvylo-backend",
  "description": "API PHP de Cuvylo (aucune dépendance de production).",
  "type": "project",
  "license": "PolyForm-Noncommercial-1.0.0",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": { "Cuvylo\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Cuvylo\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S 127.0.0.1:8080 bin/dev-router.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
